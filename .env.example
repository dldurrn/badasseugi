# Supabase — 프로젝트 설정 > API 에서 확인
# ANON_KEY 자리에는 새 이름인 Publishable key(sb_publishable_...)를 넣어도 됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서비스 롤 키는 쓰지 않습니다.
# 이 앱은 로그인한 사용자 권한으로만 DB에 접근해야 RLS(가족별 분리)가 제 역할을 합니다.
# 서비스 롤 키를 넣으면 RLS를 통째로 우회하게 되므로 변수 자체를 두지 않습니다.

# 문제지 사진 인식용. 서버 라우트에서만 사용됩니다.
ANTHROPIC_API_KEY=sk-ant-...

# 사진 인식 1일 호출 제한 (비용 급증 방지)
OCR_DAILY_LIMIT=30

# 문장 읽어주기 (Google Cloud Text-to-Speech). 서버 라우트에서만 사용됩니다.
# 콘솔에서 Cloud Text-to-Speech API만 허용하도록 키 제한을 걸어 주세요.
GOOGLE_TTS_API_KEY=

# 음성 합성 1일 글자 수 제한 (가족당). 과금 단위가 글자 수입니다.
TTS_DAILY_LIMIT=20000

# 음성 — 있으면 타입캐스트, 없으면 위의 Google 을 씁니다.
# 지우면 곧바로 Google 로 되돌아갑니다.
TYPECAST_API_KEY=
# 기본 목소리를 바꾸고 싶을 때만. 비우면 tts-engines.ts 의 첫 번째를 씁니다.
TYPECAST_VOICE_ID=
